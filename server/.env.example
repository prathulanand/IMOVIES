# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection (Replica Set required for multi-document transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/imovies_dev?replicaSet=rs0

# JWT Authentication
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway (Test Mode Keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_replace_with_your_webhook_secret

# Google OAuth (Optional - for token verification on server)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Booking Business Rules
HOLD_MINUTES=7
CONVENIENCE_FEE_PERCENT=5
MAX_SEATS_PER_BOOKING=8

# Brevo Email Configuration (REST API)
BREVO_API_KEY=your_brevo_api_key_here

# SMTP Email Configuration (Gmail / Mailgun / AWS SES / Brevo SMTP Relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_brevo_key_or_smtp_password
SMTP_FROM="IMovies Ticketing" <your_email@gmail.com>

