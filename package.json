{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies — Movie ticket booking made simple.",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:e2e": "npm --prefix server run test:e2e",
    "seed": "npm --prefix server run seed",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
